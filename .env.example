# Copy this file to .env and fill in the values.
#   Mac/Linux: cp .env.example .env
#   Windows:   copy .env.example .env

# ── Backend (optimizer_api.py / run.py) ───────────────────────────────────────

# MongoDB Atlas connection string.
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Database name (optional, default: fleet_optimizer).
MONGO_DB=fleet_optimizer

# HERE Maps API key (https://platform.here.com/). Used by /api/geocode, and by
# the optimizer for road distances and travel times (HERE Matrix Routing API).
# Without it the optimizer uses straight-line distances at each vehicle's fixed speed.
HERE_API_KEY=your-here-api-key

# Port the Flask API listens on (optional, default: 5001; macOS AirPlay uses 5000).
# Most hosting platforms set this for you.
PORT=5001

# ── Frontend (Vite, read at build time) ───────────────────────────────────────

# Backend base URL, no trailing slash (optional locally, default: http://localhost:5001).
VITE_API_URL=http://localhost:5001

# ESP32 IoT device address on your local network (optional, default: http://172.20.10.6).
# Reached through the /iot-device proxy, which only exists under `npm run dev`.
VITE_IOT_DEVICE_URL=http://172.20.10.6

# Start the IoT feed in mock mode (default: true). Set to false to start on the
# real ESP32. The Mock / ESP32 toggle on the Live Fleet map overrides this per browser.
VITE_IOT_USE_MOCK=true

# Public hostname(s) of the deployed frontend, comma-separated, when it is served
# with `npm start` (vite preview). Read when the server starts, not at build time.
# Leave empty locally: localhost is always allowed.
PREVIEW_ALLOWED_HOSTS=
