# Copy this file to .env and fill in the values.
#   Mac/Linux: cp .env.example .env
#   Windows:   copy .env.example .env

# ── Backend (optimizer_api.py / run.py) ───────────────────────────────────────

# MongoDB Atlas connection string.
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Database name (optional, default: fleet_optimizer).
MONGO_DB=fleet_optimizer

# HERE Maps API key, used by /api/geocode (https://platform.here.com/).
HERE_API_KEY=your-here-api-key

# Port the Flask API listens on (optional, default: 5000). Railway sets this.
PORT=5000

# ── Frontend (Vite, read at build time) ───────────────────────────────────────

# Backend base URL, no trailing slash (optional locally, default: http://localhost:5000).
VITE_API_URL=http://localhost:5000

# ESP32 IoT device address on your local network (optional, default: http://172.20.10.6).
VITE_IOT_DEVICE_URL=http://172.20.10.6
